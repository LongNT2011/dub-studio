{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dub Studio",
  "version": "2.0.0",
  "identifier": "com.dubstudio.desktop",
  "build": {
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "resources": {
      "staging/dub-server.exe": "dub-server.exe",
      "staging/frontend/dist": "frontend/dist",
      "staging/fonts": "fonts",
      "staging/models/higgs-engine": "models/higgs-engine",
      "staging/models/ocr": "models/ocr"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
